# Safe runtime defaults
PATIENT_CODE=RGN-0417
PATIENT_REPOSITORY=in_memory
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Phone survey (Twilio carries the call, Deepgram does the speech)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
# Public HTTPS base URL Twilio can reach, e.g. an ngrok tunnel to port 8000
PUBLIC_BASE_URL=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
UTTERANCE_END_MS=1200

# Conversational answer interpretation; without a key, uses exact option matching.
# Set SURVEY_EXTRACTOR=exact for offline operation even when a key is present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SURVEY_EXTRACTOR=openai

# Optional Postgres/Supabase. The voice app still defaults to in-memory
# persistence. Keep service-role / database URLs on the server only.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or voice_web/.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
