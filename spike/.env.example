# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Phone number to call for the spike (must be verified on a Twilio trial account)
TEST_DESTINATION_NUMBER=+1XXXXXXXXXX

# Deepgram
DEEPGRAM_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Public URL Twilio can reach (e.g. an ngrok https URL, no trailing slash)
# ngrok http 3000  ->  copy the https forwarding URL here
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

PORT=3000
