# Deepgram
DEEPGRAM_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=3000

# Gait-checker handoff (see docs/architecture.md's integration contract).
# Point this at the real GaitGuard deployment/dev server once you have it; the spike will
# still run against the default below, it just won't reach a real backend.
GAIT_CHECKER_BASE_URL=https://gaitguard.ai
# Hardcoded stand-in patient for the spike (the full build looks this up per-patient).
PATIENT_CODE=RGN-0417
# Your own phone number in E.164 (e.g. +16175551234), only needed if you fill in the Twilio
# vars below to test a real SMS send. Leave blank to use the spoken/logged fallback.
PATIENT_PHONE_NUMBER=

# Optional: fill these in to actually send the gait-checker link via SMS (Twilio's Messaging
# API -- a much lighter integration than the Voice/Media Streams product this project dropped).
# Leave all three blank to fall back to just speaking/logging the link.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=

# Supabase (hackathon demo project -- permissive RLS, no real patient data, safe to share
# within the team; run spike/scripts/seed.ts once against it before your first real call).
